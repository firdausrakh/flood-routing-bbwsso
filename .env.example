# Backend runtime: local atau r2
DATA_BACKEND=local

# Server lokal
FLOOD_HOST=127.0.0.5
FLOOD_PORT=8000

# Cloudflare R2 (dibutuhkan bila DATA_BACKEND=r2 atau upload R2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Opsional bila ingin endpoint S3-compatible eksplisit:
R2_ENDPOINT_URL=
# Jumlah unduhan R2 paralel untuk pemanasan aset display (aman untuk Vercel).
R2_DOWNLOAD_WORKERS=4

# Runtime hasil HEC-HMS. Default bucket sesuai proyek ini.
R2_RUNTIME_BUCKET=flood-routing
R2_HMS_PREFIX=
# Manifest dibuat oleh preprocess_hms_r2.bat; kosong memakai path bawaan.
R2_HMS_MANIFEST_KEY=
# Set 1 hanya saat perlu memaksa unduh ulang cache instance Vercel.
R2_REFRESH_CACHE=0

# Aset resmi reuse dari Web Delineasi DTA; tidak perlu diupload ulang.
R2_REFERENCE_BUCKET=dta-map-assets
R2_REFERENCE_PREFIX=
R2_OFFICIAL_BASINS_KEY=official_basins.geojson
R2_OFFICIAL_RIVERS_KEY=official_rivers.geojson
# URL publik/CDN bucket dta-map-assets agar map dapat memuat asset sebelum engine warm.
R2_MAP_ASSETS_PUBLIC_BASE=
R2_MAP_ASSETS_VERSION=

# Toponim bersifat opsional untuk deployment R2.
R2_TOPONYM_BUCKET=flood-routing
R2_TOPONYM_KEY=reference/toponim.sqlite

# Tile Google opsional
GOOGLE_MAPS_TILE_URL=
GOOGLE_SATELLITE_TILE_URL=
